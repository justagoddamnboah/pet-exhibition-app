{
  "realm": "course",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "visitor"
      },
      {
        "name": "admin"
      },
      {
        "name": "service"
      },
      {
        "name": "operator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "course-bff",
      "protocol": "openid-connect",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "course-bff-secret",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": ["http://localhost:8088/login/oauth2/code/keycloak", "http://localhost:18088/login/oauth2/code/keycloak"],
      "webOrigins": ["http://localhost:8088", "http://localhost:18088"],
      "defaultClientScopes": ["basic", "web-origins", "profile", "roles", "email"],
      "protocolMappers": [
        {
          "name": "aud-exhibition",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "exhibition-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "course-service-client",
      "protocol": "openid-connect",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "course-service-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "review-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "course-ops-client",
      "protocol": "openid-connect",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "course-ops-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "review-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "course-other-client",
      "protocol": "openid-connect",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "course-other-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "other-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "scopeMappings": [
    {
      "client": "course-bff",
      "roles": ["visitor", "admin"]
    },
    {
      "client": "course-service-client",
      "roles": [
        "service"
      ]
    },
    {
      "client": "course-ops-client",
      "roles": [
        "operator"
      ]
    },
    {
      "client": "course-other-client",
      "roles": [
        "service"
      ]
    }
  ],
  "users": [
    {
      "username": "visitor",
      "firstName": "Course",
      "lastName": "Visitor",
      "enabled": true,
      "email": "visitor@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "visitor",
          "temporary": false
        }
      ],
      "realmRoles": ["visitor"]
    },
    {
      "username": "admin",
      "firstName": "Course",
      "lastName": "Admin",
      "enabled": true,
      "email": "admin@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["visitor", "admin"]
    },
    {
      "username": "service-account-course-service-client",
      "enabled": true,
      "serviceAccountClientId": "course-service-client",
      "realmRoles": [
        "service"
      ]
    },
    {
      "username": "service-account-course-ops-client",
      "enabled": true,
      "serviceAccountClientId": "course-ops-client",
      "realmRoles": [
        "operator"
      ]
    },
    {
      "username": "service-account-course-other-client",
      "enabled": true,
      "serviceAccountClientId": "course-other-client",
      "realmRoles": [
        "service"
      ]
    }
  ]
}